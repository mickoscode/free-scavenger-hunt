{
  "name": "free-scavenger-hunt",
  "private": true,
  "type": "module",
  "description": "A website that lets anyone create and run a free scavenger hunt for their community.",
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "npm run build && node --test \"tests/unit/*.test.js\" \"tests/api/*.test.js\"",
    "test:browser": "npm run build && node --test --test-concurrency=2 --test-timeout=90000 \"tests/browser/*.test.js\"",
    "dev": "npm run build && node scripts/dev-server.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1177.0",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/lib-dynamodb": "^3.1177.0",
    "playwright": "^1.65.1"
  }
}
